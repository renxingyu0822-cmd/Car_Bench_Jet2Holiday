{
  manifest_version: "0.1.0",
  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
    },
    required: ["openai_api_key"],
    additionalProperties: false,
  },
  program: {
    image: "ghcr.io/renxingyu0822-cmd/car_bench_jet2holiday-car-bench-agent:latest",
    entrypoint: ["uv", "run", "src/purple_car_bench_agent/server.py", "--host", "0.0.0.0", "--port", "8080"],
    env: {
      OPENAI_API_KEY: "${config.openai_api_key}",
      AGENT_LLM: "gpt-4.1",
      AGENT_TEMPERATURE: "1.0",
    },
    network: {
      endpoints: [{ name: "endpoint", port: 8080 }],
    },
  },
  provides: { a2a: { kind: "a2a", endpoint: "endpoint" } },
  exports: { a2a: "a2a" },
}
